# Deployed to the production/staging web root (public_html/).
# Governs the STATIC site. The API has its own .htaccess in public_html/api/.

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HTTPS answers on the apex and www (checked 2026-11-15). Browsers cache this for a year.
  # No includeSubDomains: staging or other hosts under this name may not all have HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Scripts only from this site: an injected <script> or inline handler never runs.
  #  - 'unsafe-eval': the mascot's library (js/lib/avatar-web-*.js) validates its character
  #    with ajv, which compiles validators with new Function. Drop it if the mascot goes.
  #  - style 'unsafe-inline': a few style="" attributes in the pages and dashboard.
  #  - no form-action: checkout posts to the payment gateway, which redirects on to hosts
  #    we do not control; a form-action list would break payments on such a hop.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# Account, checkout and admin pages carry <meta name="robots" content="noindex">;
# the header also covers anything served there that is not HTML.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(auth/|admin/|checkout\.html|dashboard\.html)" DIWAN_NOINDEX
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=DIWAN_NOINDEX
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One host: www → apex in a single hop (also upgrades http).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # One URL for the homepage. THE_REQUEST matches only what the client asked
  # for, so DirectoryIndex serving index.html for "/" does not loop.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]

  # Browsers and crawlers request /favicon.ico regardless of <link rel="icon">.
  RewriteRule ^favicon\.ico$ /assets/logo.png [R=301,L]
</IfModule>

# Block dotfiles, the FTP sync state file, and anything that leaks config.
<FilesMatch "^\.|\.(env|ini|log|sql|md|sh|json|bak|dist|yml|yaml|pem|key|p8|p12|pfx)$|~$|^error_log$">
  Require all denied
</FilesMatch>
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Never let a stray binary be served from the web root.
<FilesMatch "(?i)\.(exe|dmg|apk|aab|msi|pkg|appimage|deb|rpm|zip|tar|gz)$">
  Require all denied
</FilesMatch>

# nosniff above means a wrong type stops the video playing.
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
