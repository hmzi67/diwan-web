# =============================================================================
# Diwan POS — environment template
# Copy to backend/config/.env for local dev.  On the server this file is
# GENERATED by CI from GitHub Secrets — never upload it by hand, never commit it.
# =============================================================================

APP_ENV=local              # local | staging | production
APP_DEBUG=false            # true shows error messages locally; ignored when APP_ENV=production
APP_URL=http://localhost:8000
APP_KEY=                   # 32+ random bytes, base64. Used to sign download tokens.

# ---- Diagnostics ----
HEALTH_DIAGNOSTICS=false   # true adds failure hints to /api/health.php while debugging a deploy
LOG_DEBUG=false            # true writes debug-level entries to the app log
LOG_RETENTION_DAYS=30      # app log files older than this are deleted (they hold IP addresses)

# ---- Database (MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diwan
DB_USER=diwan_app
DB_PASS=

# ---- Filesystem ----
# Absolute path to the installer store. MUST be outside the web root.
PRIVATE_STORAGE_PATH=/home/YOURUSER/app/private-storage

# ---- Licence policy ----
# How long a purchased licence stays valid, in days.
# 0 = never expires. That is the default and it matches what the pricing page
# sells: a one-time licence, no subscription, no renewal. Set a positive value
# ONLY if you deliberately start selling time-limited licences.
#
# NOTE: this used to be driven by DOWNLOAD_TOKEN_TTL_DAYS, which made every
# licence die 30 days after purchase. That setting is gone; see
# database/migrations/005_fix_license_expiry.sql.
LICENSE_VALIDITY_DAYS=0

# ---- Desktop-app licence signing ----
# Ed25519 keypair that signs the licence-status payloads the desktop app
# caches and re-verifies offline on every launch. This is NOT APP_KEY and
# must not be derived from it: APP_KEY is symmetric (verify == forge), so it
# can never leave the server; the app only ever embeds the PUBLIC half of
# this pair, which can verify but not forge.
#
# Generate with:  php scripts/generate-license-signing-key.php <key-id>
# On the server both come from GitHub (Secret + repository Variable).
LICENSE_SIGNING_KEY_ID=          # e.g. 2026-09 — must match a kid in the app's ACCEPTED_PUBLIC_KEYS
LICENSE_SIGNING_PRIVATE_KEY=     # base64, 64 bytes. Never commit, never log.
# How many days the desktop app may run without a successful online licence
# refresh before it locks billing until it gets one. Signed into every
# payload, so changing it here takes effect on each app's next refresh.
LICENSE_MAX_OFFLINE_DAYS=30

# ---- Download policy ----
# These govern DOWNLOADS ONLY and are independent of licence validity above.
DOWNLOAD_LINK_TTL_MINUTES=15    # how long a single download link stays usable
# Licences are perpetual, so this must leave headroom for reinstalls and
# device changes over the life of the licence — not just the first install.
DOWNLOAD_MAX_ATTEMPTS=20        # how many times one licence may pull a file

# ---- Payment gateway ----
PAYMENT_GATEWAY=jazzcash        # jazzcash | easypaisa | safepay

# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform

# EasyPaisa
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Safepay
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=

# ---- Apple: App Store purchases (iOS app) + Sign in with Apple ----
# Full setup walkthrough: docs/APPLE.md
#
# In-app purchases need NO key: StoreKit transactions are verified offline
# against Apple's pinned root certificate.
APPLE_BUNDLE_ID=com.diwan.pos      # must equal the app's tauri.conf.json "identifier"
APPLE_APP_ID=                      # numeric Apple ID of the app (App Store Connect → App Information)
APPLE_IAP_ALLOW_SANDBOX=true       # keep true: App Review buys in the sandbox even for production builds
# App Store product id → licence SKU. Blank = the defaults below.
# APPLE_IAP_PRODUCTS=com.diwan.pos.license.starter=diwan-pos-starter,com.diwan.pos.license.standard=diwan-pos-standard,com.diwan.pos.license.enterprise=diwan-pos-enterprise
# APPLE_RESTORE_MOVE_COOLDOWN_DAYS=30   # self-service device moves via "Restore purchases"
#
# Sign in with Apple on the WEBSITE: the Services ID (an identifier you
# create in the developer portal, e.g. com.diwan.pos.web). Blank = the
# website's Apple button stays hidden. The app always signs in as APPLE_BUNDLE_ID.
APPLE_SIGN_IN_SERVICES_ID=
# APPLE_SIGN_IN_REDIRECT_URI=      # blank = APP_URL/auth/login.html (must be registered on the Services ID)
#
# Sign in with Apple REST key — lets account deletion revoke Apple's token,
# which App Review requires for the iOS app. Keys → "+" → Sign in with Apple.
APPLE_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=         # base64 of the whole .p8 file: base64 -i AuthKey_XXXX.p8 | tr -d '\n'

# ---- Installer downloads from GitHub releases ----
# Installers live on a (private) GitHub release. After the licence check the
# server asks GitHub for a short-lived signed URL and redirects the customer to
# it. Register a release with: php scripts/sync-github-release.php v1.1.5
# Token: fine-grained PAT limited to this one repo, "Contents: Read-only".
# In GitHub Actions store it as the secret POS_RELEASES_TOKEN (the GITHUB_
# prefix is reserved there); deploy.yml writes it here under this name.
GITHUB_RELEASES_REPO=owner/repo        # the private repository whose releases hold the installers
GITHUB_RELEASES_TOKEN=

# ---- Mail (verification links, licence delivery) ----
# Production on Hostinger SMTP (recommended): create the mailbox in hPanel ->
# Emails, then point the app at it. MAIL_FROM must be the same mailbox as
# MAIL_USERNAME — Hostinger rejects a From address it doesn't own.
#
#   MAIL_DRIVER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=587                 # STARTTLS; use 465 for implicit TLS
#   MAIL_USERNAME=you@yourdomain.com   # full mailbox address, not an alias
#   MAIL_PASSWORD=<mailbox password>   # NOT your hPanel login password
#   MAIL_FROM=you@yourdomain.com
#
# (Titan mailboxes bundled with some Hostinger plans use smtp.titan.email
# instead of smtp.hostinger.com.)
#
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Diwan POS
# Inbox that receives contact form enquiries (replies go straight to the sender).
CONTACT_EMAIL=

# MAIL_DRIVER=sendmail uses PHP's mail(), which relies on the host's local
# MTA — this is what shared hosting already has, so production needs no
# further config. On a local machine mail() usually goes nowhere silently,
# because there's no MTA (Postfix etc.) actually running/relaying.
#
# For local dev, switch to MAIL_DRIVER=smtp and point it at either:
#  - a mail catcher, so sent mail lands in a real inbox you can view
#    instead of vanishing: `brew install mailpit && mailpit`
#    (UI at http://localhost:8025), MAIL_HOST=127.0.0.1, MAIL_PORT=1025
#  - a Mailtrap sandbox inbox: same shape, its own host/port/credentials
#  - real Gmail SMTP: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
#    MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<Google Account app
#    password — NOT your normal Gmail password; generate one at
#    https://myaccount.google.com/apppasswords (needs 2-Step Verification
#    on). MAIL_FROM must equal MAIL_USERNAME or Gmail silently drops the
#    send. Port 587 always negotiates STARTTLS automatically.
MAIL_DRIVER=sendmail            # sendmail | smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# TEMPORARY no-payment onboarding. False stops new grants, not existing access.
TRIAL_SIGNUP_ENABLED=true
