# =============================================================================
# Diwan POS — environment template
# Copy to backend/config/.env for local dev.  On the server this file is
# GENERATED by CI from GitHub Secrets — never upload it by hand, never commit it.
# =============================================================================

APP_ENV=local              # local | staging | production
APP_DEBUG=true             # MUST be false in production
APP_URL=http://localhost:8000
APP_KEY=                   # 32+ random bytes, base64. Used to sign download tokens.

# ---- Database (MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diwan
DB_USER=diwan_app
DB_PASS=

# ---- Filesystem ----
# Absolute path to the installer store. MUST be outside the web root.
PRIVATE_STORAGE_PATH=/home/YOURUSER/app/private-storage

# ---- Licence policy ----
# How long a purchased licence stays valid, in days.
# 0 = never expires. That is the default and it matches what the pricing page
# sells: a one-time licence, no subscription, no renewal. Set a positive value
# ONLY if you deliberately start selling time-limited licences.
#
# NOTE: this used to be driven by DOWNLOAD_TOKEN_TTL_DAYS, which made every
# licence die 30 days after purchase. That setting is gone; see
# database/migrations/005_fix_license_expiry.sql.
LICENSE_VALIDITY_DAYS=0

# ---- Download policy ----
# These govern DOWNLOADS ONLY and are independent of licence validity above.
DOWNLOAD_LINK_TTL_MINUTES=15    # how long a single download link stays usable
# Licences are perpetual, so this must leave headroom for reinstalls and
# device changes over the life of the licence — not just the first install.
DOWNLOAD_MAX_ATTEMPTS=20        # how many times one licence may pull a file

# ---- Payment gateway ----
PAYMENT_GATEWAY=jazzcash        # jazzcash | easypaisa | safepay

# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform

# EasyPaisa
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Safepay
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=

# ---- Mail (licence delivery, login links) ----
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Diwan POS

# MAIL_DRIVER=sendmail uses PHP's mail(), which relies on the host's local
# MTA — this is what shared hosting already has, so production needs no
# further config. On a local machine mail() usually goes nowhere silently,
# because there's no MTA (Postfix etc.) actually running/relaying.
#
# For local dev, switch to MAIL_DRIVER=smtp and point it at either:
#  - a mail catcher, so sent mail lands in a real inbox you can view
#    instead of vanishing: `brew install mailpit && mailpit`
#    (UI at http://localhost:8025), MAIL_HOST=127.0.0.1, MAIL_PORT=1025
#  - a Mailtrap sandbox inbox: same shape, its own host/port/credentials
#  - real Gmail SMTP: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
#    MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<Google Account app
#    password — NOT your normal Gmail password; generate one at
#    https://myaccount.google.com/apppasswords (needs 2-Step Verification
#    on). MAIL_FROM must equal MAIL_USERNAME or Gmail silently drops the
#    send. Port 587 always negotiates STARTTLS automatically.
MAIL_DRIVER=sendmail            # sendmail | smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
