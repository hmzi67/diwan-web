# =============================================================================
# Diwan POS — environment template
# Copy to backend/config/.env for local dev.  On the server this file is
# GENERATED by CI from GitHub Secrets — never upload it by hand, never commit it.
# =============================================================================

APP_ENV=local              # local | staging | production
APP_DEBUG=true             # MUST be false in production
APP_URL=http://localhost:8000
APP_KEY=                   # 32+ random bytes, base64. Used to sign download tokens.

# ---- Database (MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diwan
DB_USER=diwan_app
DB_PASS=

# ---- Filesystem ----
# Absolute path to the installer store. MUST be outside the web root.
PRIVATE_STORAGE_PATH=/home/YOURUSER/app/private-storage

# ---- Download policy ----
DOWNLOAD_TOKEN_TTL_DAYS=30      # token validity window after purchase
DOWNLOAD_MAX_ATTEMPTS=5         # how many times one licence may pull a file

# ---- Payment gateway ----
PAYMENT_GATEWAY=jazzcash        # jazzcash | easypaisa | safepay

# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform

# EasyPaisa
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Safepay
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=

# ---- Mail (licence delivery) ----
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Diwan POS
