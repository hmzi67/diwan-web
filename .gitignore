# ---- Secrets: never commit real credentials ----
.env
.env.*
!.env.example
backend/config/.env
backend/public/_app_root.php

# ---- Build output (regenerated by CI, not source of truth) ----
frontend/dist/

# ---- Installer binaries: NEVER in git, NEVER deployed ----
backend/private-storage/releases/*
!backend/private-storage/releases/.gitkeep
backend/private-storage/logs/*
!backend/private-storage/logs/.gitkeep
*.exe
*.dmg
*.apk
*.msi
*.pkg

# ---- Dependencies / tooling ----
node_modules/
vendor/
composer.lock

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- FTP sync state (lives on the server, not in the repo) ----
.ftp-deploy-sync-state.json
