# Deployed to public_html/api/ — the ONLY directory from which PHP is served.

Options -Indexes
DirectoryIndex index.php

# Internal includes and the generated app-root pointer are never entrypoints.
<FilesMatch "^_">
  Require all denied
</FilesMatch>

# No dotfiles, no config, no leftovers.
<FilesMatch "^\.|\.(env|ini|log|sql|md|sh|json|bak|dist|yml|yaml|example|pem|key|p8|p12|pfx)$|~$|^error_log$">
  Require all denied
</FilesMatch>

# Installers are only ever streamed by download.php from private storage;
# a stray copy in this directory must not be downloadable directly.
<FilesMatch "(?i)\.(exe|dmg|apk|aab|msi|pkg|appimage|deb|rpm|zip|tar|gz)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  # Responses are JSON or a file stream: nothing here should ever run as a page.
  Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # Download links must never be cached by a proxy.
  Header always set Cache-Control "no-store"
</IfModule>

# The one HTML page here (where the browser lands after paying): the site's
# stylesheet and the inline style on its <main>, still no scripts.
<Files "payment-return.php">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
  </IfModule>
</Files>

# Large installers stream through download.php; give them room.
<IfModule mod_php.c>
  php_value max_execution_time 600
  php_value output_buffering 0
</IfModule>

# Webhooks come from the gateway, not a browser — no CORS, no credentials.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/api/$1 [R=301,L]
</IfModule>
